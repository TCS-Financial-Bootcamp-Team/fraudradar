<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_aml_monitoring" targetNamespace="https://github.com/TCS-Financial-Bootcamp-Team/fraudradar/docs/bpmn">
  <bpmn:collaboration id="Collaboration_aml_monitoring">
    <bpmn:participant id="Participant_data_sources" name="Fontes de dados (CSV, API, banco externo, simulador)" />
    <bpmn:participant id="Participant_fraudradar" name="FraudRadar PLD" processRef="Process_aml_monitoring" />
    <bpmn:participant id="Participant_coaf" name="COAF" />
    <bpmn:messageFlow id="MessageFlow_transactions" name="Transações (sem gabarito)" sourceRef="Participant_data_sources" targetRef="Event_transactions_received" />
    <bpmn:messageFlow id="MessageFlow_suspicious_activity_report" name="Comunicação de operação suspeita" sourceRef="Task_send_to_coaf" targetRef="Participant_coaf" />
  </bpmn:collaboration>
  <bpmn:process id="Process_aml_monitoring" name="Monitoramento PLD: da transação à comunicação ao COAF" isExecutable="false">
    <bpmn:documentation>Visão de ponta a ponta. O processamento do período está no diagrama 2 (02-period-processing.bpmn); o retreino com o retorno dos analistas, no diagrama 3 (03-model-retraining.bpmn).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_aml_monitoring">
      <bpmn:lane id="Lane_system" name="Sistema (API, worker e IA)">
        <bpmn:flowNodeRef>Event_transactions_received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_validate_submission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_awaiting_processing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_processing_interval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_process_now</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_processing_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_process_open_period</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_queue_updated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_draft_assessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_build_report_draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_analyst" name="Analista de PLD">
        <bpmn:flowNodeRef>Event_queue_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_open_alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_analyze_evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_record_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_alert_archived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_approve_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_send_to_coaf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_alert_closed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_transactions_received" name="Transações recebidas">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_transactions_received_definition" messageRef="Message_transacoes_recebidas" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_validate_submission" name="Validar e gravar o envio (tudo ou nada)">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_awaiting_processing" name="Transações aguardam o processamento">
      <bpmn:incoming>Flow_02</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Event_processing_interval" name="A cada intervalo (padrão: 1 h)">
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_processing_interval_definition">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Event_process_now" name="Pedido 'Processar agora'">
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_process_now_definition" messageRef="Message_processar_agora" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_processing_merge">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Activity_process_open_period" name="Processar o período aberto" calledElement="Process_period_processing">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="Event_queue_updated" name="Fila atualizada">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:signalEventDefinition id="Event_queue_updated_definition" signalRef="Signal_fila_atualizada" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_draft_assessment" name="Redigir o parecer com IA (RAG)">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="DataStore_decisions" name="Decisões, rótulos do retorno e auditoria" />
    <bpmn:serviceTask id="Task_build_report_draft" name="Gerar o rascunho da comunicação">
      <bpmn:incoming>Flow_report</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Event_queue_ready" name="Fila atualizada">
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:signalEventDefinition id="Event_queue_ready_definition" signalRef="Signal_fila_atualizada" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_open_alert" name="Abrir um alerta pendente (contas suspeitas ou fila)">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_analyze_evidence" name="Analisar as evidências e o parecer">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:incoming>Flow_escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_record_decision" name="Registrar a decisão com justificativa">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1">
        <bpmn:targetRef>DataStore_decisions</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_decision" name="Qual decisão?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_report</bpmn:outgoing>
      <bpmn:outgoing>Flow_archive</bpmn:outgoing>
      <bpmn:outgoing>Flow_escalate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_alert_archived" name="Alerta arquivado">
      <bpmn:incoming>Flow_archive</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_approve_report" name="Revisar e aprovar a comunicação">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_send_to_coaf" name="Enviar a comunicação ao COAF (fora do sistema)">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="Event_alert_closed" name="Alerta encerrado">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Event_transactions_received" targetRef="Task_validate_submission" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_validate_submission" targetRef="Event_awaiting_processing" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Event_processing_interval" targetRef="Gateway_processing_merge" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Event_process_now" targetRef="Gateway_processing_merge" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_processing_merge" targetRef="Activity_process_open_period" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Activity_process_open_period" targetRef="Event_queue_updated" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Event_queue_ready" targetRef="Task_open_alert" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_open_alert" targetRef="Task_draft_assessment" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_draft_assessment" targetRef="Task_analyze_evidence" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_analyze_evidence" targetRef="Task_record_decision" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_record_decision" targetRef="Gateway_decision" />
    <bpmn:sequenceFlow id="Flow_report" name="Comunicar ao COAF" sourceRef="Gateway_decision" targetRef="Task_build_report_draft" />
    <bpmn:sequenceFlow id="Flow_archive" name="Arquivar" sourceRef="Gateway_decision" targetRef="Event_alert_archived" />
    <bpmn:sequenceFlow id="Flow_escalate" name="Aprofundar" sourceRef="Gateway_decision" targetRef="Task_analyze_evidence" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_build_report_draft" targetRef="Task_approve_report" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_approve_report" targetRef="Task_send_to_coaf" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_send_to_coaf" targetRef="Event_alert_closed" />
    <bpmn:textAnnotation id="Note_period_detail">
      <bpmn:text>Detalhe no diagrama 2: nota de cada transação, fila por conta (até 300), amostra de controle e evidências. Períodos fechados não mudam.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_period_detail" associationDirection="None" sourceRef="Note_period_detail" targetRef="Activity_process_open_period" />
    <bpmn:textAnnotation id="Note_assessment_planned">
      <bpmn:text>Sob demanda (POST /alerts/{id}/assessment): gera o parecer com RAG e sugere a tipologia. O LLM nunca recebe o número da conta.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_assessment_planned" associationDirection="None" sourceRef="Note_assessment_planned" targetRef="Task_draft_assessment" />
    <bpmn:textAnnotation id="Note_feedback_labels">
      <bpmn:text>Rótulo do retorno: comunicar = 1; falso positivo confirmado = 0; sem evidência suficiente e aprofundar não deixam rótulo. Usado no retreino (diagrama 3).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_feedback_labels" associationDirection="None" sourceRef="Note_feedback_labels" targetRef="DataStore_decisions" />
    <bpmn:textAnnotation id="Note_justification">
      <bpmn:text>Justificativa obrigatória (mín. 10 caracteres), com o nome do analista. Arquivar exige o motivo: falso positivo confirmado ou sem evidência suficiente.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_justification" associationDirection="None" sourceRef="Note_justification" targetRef="Task_record_decision" />
    <bpmn:textAnnotation id="Note_last_decision">
      <bpmn:text>Vale a última decisão: ela pode ser refeita até a comunicação ser aprovada.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_last_decision" associationDirection="None" sourceRef="Note_last_decision" targetRef="Gateway_decision" />
    <bpmn:textAnnotation id="Note_outside_system">
      <bpmn:text>A aprovação encerra o alerta no FraudRadar, que não envia nada: o envio ao COAF, pelo Siscoaf, fica fora do sistema (simulação acadêmica).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_outside_system" associationDirection="None" sourceRef="Note_outside_system" targetRef="Task_send_to_coaf" />
  </bpmn:process>
  <bpmn:message id="Message_transacoes_recebidas" name="Transações recebidas" />
  <bpmn:message id="Message_processar_agora" name="Processar agora" />
  <bpmn:signal id="Signal_fila_atualizada" name="Fila atualizada" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_aml_monitoring" name="Monitoramento PLD: da transação à comunicação ao COAF">
    <bpmndi:BPMNPlane id="BPMNPlane_aml_monitoring" bpmnElement="Collaboration_aml_monitoring">
      <bpmndi:BPMNShape id="Participant_data_sources_di" bpmnElement="Participant_data_sources" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="2285" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_fraudradar_di" bpmnElement="Participant_fraudradar" isHorizontal="true">
        <dc:Bounds x="0" y="110" width="2285" height="610" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_coaf_di" bpmnElement="Participant_coaf" isHorizontal="true">
        <dc:Bounds x="0" y="770" width="2285" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_system_di" bpmnElement="Lane_system" isHorizontal="true">
        <dc:Bounds x="30" y="110" width="2255" height="350" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_analyst_di" bpmnElement="Lane_analyst" isHorizontal="true">
        <dc:Bounds x="30" y="460" width="2255" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_transactions_received_di" bpmnElement="Event_transactions_received">
        <dc:Bounds x="165" y="157" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="199" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_validate_submission_di" bpmnElement="Task_validate_submission">
        <dc:Bounds x="283" y="130" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_awaiting_processing_di" bpmnElement="Event_awaiting_processing">
        <dc:Bounds x="495" y="157" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="539" y="154" width="90" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_processing_interval_di" bpmnElement="Event_processing_interval">
        <dc:Bounds x="165" y="267" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="309" width="90" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_process_now_di" bpmnElement="Event_process_now">
        <dc:Bounds x="165" y="377" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="419" width="90" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_processing_merge_di" bpmnElement="Gateway_processing_merge" isMarkerVisible="true">
        <dc:Bounds x="323" y="260" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_process_open_period_di" bpmnElement="Activity_process_open_period">
        <dc:Bounds x="448" y="240" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_queue_updated_di" bpmnElement="Event_queue_updated">
        <dc:Bounds x="660" y="267" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="633" y="309" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_draft_assessment_di" bpmnElement="Task_draft_assessment">
        <dc:Bounds x="943" y="350" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStore_decisions_di" bpmnElement="DataStore_decisions">
        <dc:Bounds x="1313" y="260" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1371" y="257" width="90" height="56" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_build_report_draft_di" bpmnElement="Task_build_report_draft">
        <dc:Bounds x="1603" y="350" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_queue_ready_di" bpmnElement="Event_queue_ready">
        <dc:Bounds x="660" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="633" y="554" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_open_alert_di" bpmnElement="Task_open_alert">
        <dc:Bounds x="778" y="485" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_analyze_evidence_di" bpmnElement="Task_analyze_evidence">
        <dc:Bounds x="1108" y="485" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_record_decision_di" bpmnElement="Task_record_decision">
        <dc:Bounds x="1273" y="485" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_decision_di" bpmnElement="Gateway_decision" isMarkerVisible="true">
        <dc:Bounds x="1478" y="505" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1400" y="489" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_alert_archived_di" bpmnElement="Event_alert_archived">
        <dc:Bounds x="1650" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1623" y="554" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_approve_report_di" bpmnElement="Task_approve_report">
        <dc:Bounds x="1768" y="485" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_send_to_coaf_di" bpmnElement="Task_send_to_coaf" color:background-color="#ececec" color:border-color="#6b6b6b">
        <dc:Bounds x="1933" y="485" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_alert_closed_di" bpmnElement="Event_alert_closed">
        <dc:Bounds x="2145" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2118" y="554" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_period_detail_di" bpmnElement="Note_period_detail">
        <dc:Bounds x="638" y="137" width="250" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_assessment_planned_di" bpmnElement="Note_assessment_planned">
        <dc:Bounds x="863" y="249" width="250" height="57" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_feedback_labels_di" bpmnElement="Note_feedback_labels">
        <dc:Bounds x="1213" y="137" width="290" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_justification_di" bpmnElement="Note_justification">
        <dc:Bounds x="1113" y="624" width="255" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_last_decision_di" bpmnElement="Note_last_decision">
        <dc:Bounds x="1533" y="624" width="230" height="57" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_outside_system_di" bpmnElement="Note_outside_system">
        <dc:Bounds x="2013" y="624" width="250" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="201" y="175" />
        <di:waypoint x="283" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="413" y="175" />
        <di:waypoint x="495" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="201" y="285" />
        <di:waypoint x="323" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="201" y="395" />
        <di:waypoint x="348" y="395" />
        <di:waypoint x="348" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="373" y="285" />
        <di:waypoint x="448" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="578" y="285" />
        <di:waypoint x="660" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07">
        <di:waypoint x="696" y="530" />
        <di:waypoint x="778" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08">
        <di:waypoint x="843" y="485" />
        <di:waypoint x="843" y="395" />
        <di:waypoint x="943" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09">

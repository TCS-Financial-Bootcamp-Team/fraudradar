<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_model_retraining" targetNamespace="https://github.com/TCS-Financial-Bootcamp-Team/fraudradar/docs/bpmn">
  <bpmn:collaboration id="Collaboration_model_retraining">
    <bpmn:participant id="Participant_fraudradar" name="FraudRadar PLD" processRef="Process_model_retraining" />
  </bpmn:collaboration>
  <bpmn:process id="Process_model_retraining" name="Retreino com o retorno dos analistas e promoção do modelo" isExecutable="false">
    <bpmn:documentation>O retorno nasce das decisões do diagrama 1 (01-aml-monitoring.bpmn). Regras em docs/analyst-feedback.md e docs/external-data.md.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_model_retraining">
      <bpmn:lane id="Lane_analyst" name="Analista de PLD">
        <bpmn:flowNodeRef>Event_retrain_wanted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_request_training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_compare_versions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_promote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_active_kept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_system" name="Sistema (API e worker)">
        <bpmn:flowNodeRef>Gateway_request_allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_request_refused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_enqueue_training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_train_version</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_measure_versions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_promotion_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gate_passed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_version_blocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_promote_version</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_new_version_active</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_retrain_wanted" name="Decide treinar uma versão nova">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_request_training" name="Pedir 'Treinar nova versão' (com ou sem o retorno)">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_request_allowed" name="Pedido pode seguir?">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_request_refused" name="Pedido recusado (409, com o motivo)">
      <bpmn:incoming>Flow_03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_enqueue_training" name="Enfileirar o treino (com auditoria)">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_train_version" name="Treinar a versão nova (corte no tempo)">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:property id="Property_Task_train_version_1" name="__targetRef_placeholder" />
      <bpmn:property id="Property_Task_train_version_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1">
        <bpmn:sourceRef>DataStore_analyst_labels</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_train_version_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataInputAssociation_2">
        <bpmn:sourceRef>DataStore_ground_truth</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_train_version_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_measure_versions" name="Medir a nova e a ativa nas mesmas semanas de teste">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:property id="Property_Task_measure_versions_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_3">
        <bpmn:sourceRef>DataStore_ground_truth</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_measure_versions_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_promotion_gate" name="Aplicar a trava de promoção">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_gate_passed" name="Passou na trava?">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_version_blocked" name="Versão fica registrada, mas bloqueada para promoção">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_compare_versions" name="Comparar as duas versões na tela do modelo">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_promote" name="Promover?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_active_kept" name="Versão ativa continua">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_promote_version" name="Promover a versão (com auditoria)">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_new_version_active" name="Próximas rodadas usam a versão nova">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStore_analyst_labels" name="Rótulos do retorno (analyst_labels)" />
    <bpmn:dataStoreReference id="DataStore_ground_truth" name="Gabarito do conjunto (ground_truth)" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Event_retrain_wanted" targetRef="Task_request_training" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_request_training" targetRef="Gateway_request_allowed" />
    <bpmn:sequenceFlow id="Flow_03" name="Não" sourceRef="Gateway_request_allowed" targetRef="Event_request_refused" />
    <bpmn:sequenceFlow id="Flow_04" name="Sim" sourceRef="Gateway_request_allowed" targetRef="Task_enqueue_training" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_enqueue_training" targetRef="Task_train_version" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_train_version" targetRef="Task_measure_versions" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_measure_versions" targetRef="Task_promotion_gate" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_promotion_gate" targetRef="Gateway_gate_passed" />
    <bpmn:sequenceFlow id="Flow_09" name="Sim" sourceRef="Gateway_gate_passed" targetRef="Task_compare_versions" />
    <bpmn:sequenceFlow id="Flow_10" name="Não" sourceRef="Gateway_gate_passed" targetRef="Event_version_blocked" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_compare_versions" targetRef="Gateway_promote" />
    <bpmn:sequenceFlow id="Flow_12" name="Não" sourceRef="Gateway_promote" targetRef="Event_active_kept" />
    <bpmn:sequenceFlow id="Flow_13" name="Sim" sourceRef="Gateway_promote" targetRef="Task_promote_version" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_promote_version" targetRef="Event_new_version_active" />
    <bpmn:textAnnotation id="Note_request_rules">
      <bpmn:text>Precisa de gabarito em pelo menos 6 semanas e de alguma lavagem, sem outro treino em andamento. Com o retorno: pelo menos 50 rótulos de semanas fechadas, das duas classes.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_request_rules" associationDirection="None" sourceRef="Note_request_rules" targetRef="Gateway_request_allowed" />
    <bpmn:textAnnotation id="Note_gate_rule">
      <bpmn:text>Passa se a versão nova achar, na fila, no máximo 1 ponto percentual a menos de contas lavadoras que a ativa, nas mesmas semanas.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_gate_rule" associationDirection="None" sourceRef="Note_gate_rule" targetRef="Task_promotion_gate" />
    <bpmn:textAnnotation id="Note_ground_truth_wins">
      <bpmn:text>O gabarito sempre ganha: o rótulo do analista que concorda com ele pesa 3; se discorda, vale o gabarito, com peso 1. Só entram rótulos de semanas fechadas.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_ground_truth_wins" associationDirection="None" sourceRef="Note_ground_truth_wins" targetRef="Task_train_version" />
    <bpmn:textAnnotation id="Note_labels_source">
      <bpmn:text>Gravados a cada decisão do analista (diagrama 1): comunicar = 1; falso positivo confirmado = 0.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_labels_source" associationDirection="None" sourceRef="Note_labels_source" targetRef="DataStore_analyst_labels" />
    <bpmn:textAnnotation id="Note_closed_periods">
      <bpmn:text>Períodos fechados não mudam: a versão nova vale das próximas rodadas em diante.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_closed_periods" associationDirection="None" sourceRef="Note_closed_periods" targetRef="Task_promote_version" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_model_retraining" name="Retreino com o retorno dos analistas e promoção do modelo">
    <bpmndi:BPMNPlane id="BPMNPlane_model_retraining" bpmnElement="Collaboration_model_retraining">

# Copie para .env e preencha. Nunca commite o .env.

# Postgres (Docker). Fora do Docker o host é localhost; dentro do Compose a API usa "db".
POSTGRES_USER=fraudradar
POSTGRES_PASSWORD=fraudradar
POSTGRES_DB=fraudradar
DATABASE_URL=postgresql+psycopg://fraudradar:fraudradar@localhost:5432/fraudradar

# LLM — a chave fica só na API (servidor), nunca no front.
# O time usa o Gemini. Gere a chave em https://aistudio.google.com/apikey e cole abaixo.
# Também vale o nome GOOGLE_API_KEY. Para trocar de provedor: LLM_PROVIDER=openai ou anthropic.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Modelo do provedor. O chat jurídico (POST /chat) exige: sem ele, a rota responde 503. Ex.: LLM_MODEL=gemini-2.5-flash
# A base do chat é carregada com: docker compose run --rm worker rag-load
# LLM_MODEL=
# Lista opcional de modelos Gemini permitidos separados por vírgula para seleção na UI e fallback automático (503/429).
# LLM_MODEL sempre fica incluído e em primeiro lugar. Ex.: LLM_MODEL_OPTIONS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro
# LLM_MODEL_OPTIONS=

# Embeddings do RAG (384 dimensões, igual a rag_documents.embedding)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Modelo treinado (pasta models/, fora do git)
MODEL_DIR=models
MODEL_FILE=lightgbm_model.txt
# DATA_DIR=data

# Origens liberadas no CORS da API (lista JSON)
CORS_ORIGINS=["http://localhost:3000"]

# A API valida o JWT do Supabase Auth com a chave pública do projeto (JWKS).
# Sem SUPABASE_URL ela usa NEXT_PUBLIC_SUPABASE_URL, abaixo.
# SUPABASE_URL=
# Só em desenvolvimento: aceita requisições sem sessão como "Analista local".
AUTH_DISABLED=false

# Limite de POST /ingestion/csv por envio (bytes e linhas); o padrão cabe nos 15 s da requisição.
# INGESTION_MAX_BYTES=20971520
# INGESTION_MAX_ROWS=200000

# Conexões com bancos Postgres externos (Fontes de dados). A senha é cifrada com a chave abaixo
# (Fernet), que só a API e o worker leem; o Compose passa a mesma chave aos dois (api e
# worker-serve). Sem chave, a API recusa salvar conexões; trocar a chave depois invalida as
# senhas já salvas. Gere uma chave e cole aqui (nunca commite):
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTIONS_SECRET_KEY=
# Hosts que a API e o worker podem acessar (lista separada por vírgula; vazio = recusa todos).
# O Compose passa a lista à api e ao worker-serve.
# Demo local: EXTERNAL_DB_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
EXTERNAL_DB_ALLOWED_HOSTS=

# Front: URL da API vista pelo navegador
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Portas expostas pelo Compose
# DB_PORT=5432
# API_PORT=8000
# WEB_PORT=3000

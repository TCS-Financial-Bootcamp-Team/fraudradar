# Copie para .env e preencha. Nunca commite o .env.

# Postgres (Docker). Fora do Docker o host é localhost; dentro do Compose a API usa "db".
POSTGRES_USER=fraudradar
POSTGRES_PASSWORD=fraudradar
POSTGRES_DB=fraudradar
DATABASE_URL=postgresql+psycopg://fraudradar:fraudradar@localhost:5432/fraudradar

# LLM — a chave fica só na API (servidor), nunca no front.
# O time usa o Gemini. Gere a chave em https://aistudio.google.com/apikey e cole abaixo.
# Também vale o nome GOOGLE_API_KEY. Para trocar de provedor: LLM_PROVIDER=openai ou anthropic.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Modelo do provedor (vazio: o padrão da cadeia da IA). Ex.: LLM_MODEL=gemini-2.5-flash
# LLM_MODEL=

# Embeddings do RAG (384 dimensões, igual a rag_documents.embedding)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Modelo treinado (pasta models/, fora do git)
MODEL_DIR=models
MODEL_FILE=lightgbm_model.txt
# DATA_DIR=data

# Origens liberadas no CORS da API (lista JSON)
CORS_ORIGINS=["http://localhost:3000"]

# A API valida o JWT do Supabase Auth com a chave pública do projeto (JWKS).
# Sem SUPABASE_URL ela usa NEXT_PUBLIC_SUPABASE_URL, abaixo.
# SUPABASE_URL=
# Só em desenvolvimento: aceita requisições sem sessão como "Analista local".
AUTH_DISABLED=false

# Limite de POST /ingestion/csv por envio (bytes e linhas); o padrão cabe nos 15 s da requisição.
# INGESTION_MAX_BYTES=20971520
# INGESTION_MAX_ROWS=200000

# Front: URL da API vista pelo navegador
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Portas expostas pelo Compose
# DB_PORT=5432
# API_PORT=8000
# WEB_PORT=3000
